# Maré Alerta IA — variáveis do serviço de previsão
# Copie para .env e substitua os valores de exemplo.

# Obrigatória: deve ser igual a IA_CHUVA_API_KEY no backend.
IA_CHUVA_API_KEY=gere-uma-chave-forte-e-use-a-mesma-no-backend

# Opcional: diretório dos artefatos do modelo dentro do container.
MODEL_DIR=/app/artifacts

# Usada somente pelo compose.traefik.yaml para selecionar uma imagem imutável.
IA_IMAGE_TAG=sha-<commit>
